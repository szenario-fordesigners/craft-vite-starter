.PHONY: build dev up share

build:
	ddev yarn build
dev: up
	ddev yarn dev
up:
	if [ ! "$$(ddev describe | grep OK)" ]; then \
		ddev start; \
    fi
# Craft renders absolute .ddev.site URLs a tunnel visitor can't reach, so nginx
# strips that origin from HTML. The conf is rendered from its .tmpl on every run
# (nginx can't read env vars), which keeps it right after a rename.
# Restarts ddev only when the file actually changed.
share: up
	@url=$$(ddev exec printenv PRIMARY_SITE_URL | tr -d '\r' | sed 's|/$$||'); \
	conf=.ddev/nginx/share-relative-urls.conf; \
	new=$$(sed "s|__PRIMARY_SITE_URL__|$$url|" $$conf.tmpl); \
	if [ "$$(cat $$conf 2>/dev/null)" != "$$new" ]; then \
		printf '%s\n' "$$new" > $$conf; ddev restart; \
	fi
	@# ponytail: pkill because stopping the docker exec client leaves vite running in the container
	@trap 'ddev exec pkill -f vite >/dev/null 2>&1' EXIT; \
	ddev yarn dev & \
	ddev share
%:
	@:
# ref: https://stackoverflow.com/questions/6273608/how-to-pass-argument-to-makefile-from-command-line
